{
  "name": "study-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.config.singlefile.ts",
    "preview": "vite preview",
    "check:bank": "node scripts/check-bank.mjs --cert=sc500",
    "check:bank:az500": "node scripts/check-bank.mjs --cert=az500",
    "check:bank:strict": "node scripts/check-bank.mjs --cert=sc500 --no-legacy",
    "check:banks": "npm run check:bank:strict && npm run check:bank:az500:strict",
    "verify:exam": "node scripts/verify-exam-builder.mjs",
    "verify:offline": "node scripts/verify-file-protocol.mjs",
    "verify:review": "node scripts/verify-review-queue.mjs",
    "test:e2e": "playwright install --with-deps chromium && node scripts/smoke-test.mjs",
    "check:bank:az500:strict": "node scripts/check-bank.mjs --cert=az500 --no-legacy",
    "verify:correction": "node scripts/verify-exam-correction.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
